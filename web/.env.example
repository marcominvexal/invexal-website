# Invexal email uses Microsoft 365 (MX → outlook.com), not plain cPanel SMTP.
# Copy to .env.local and fill real values. Never commit .env.local.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=marcom@invexal.com
SMTP_PASS=your-microsoft-app-password
SMTP_FROM=marcom@invexal.com
CONTACT_TO=marcom@invexal.com
