# Gmail SMTP for contact / book-a-demo forms.
# Copy to .env.local and fill real values. Never commit .env.local.
#
# Create an App Password:
# Google Account → Security → 2-Step Verification → App passwords
# Paste the 16-character password below (spaces optional).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=marcominvexal@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=marcominvexal@gmail.com
CONTACT_TO=marcominvexal@gmail.com
